{
  "name": "ribat",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fmt": "turbo run fmt",
    "db:migrate": "pnpm --filter api exec prisma migrate deploy",
    "db:studio": "pnpm --filter api exec prisma studio"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}

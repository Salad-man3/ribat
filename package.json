{
  "name": "ribat",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "turbo run dev --filter=api --filter=web",
    "dev:lan": "turbo run dev:lan --filter=api --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/monorepo-tooling.test.mjs && turbo run test",
    "test:e2e": "pnpm --filter @ribat/shared --filter @ribat/quran-data build && pnpm --filter api test:e2e",
    "fmt": "turbo run fmt",
    "db:migrate": "pnpm --filter api exec prisma migrate deploy",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:reset": "pnpm --filter api exec prisma migrate reset",
    "db:studio": "pnpm --filter api exec prisma studio",
    "android:update": "node scripts/android-update.mjs",
    "android:build": "node scripts/android-build.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}

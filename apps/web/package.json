{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test --test-reporter=dot src/**/*.test.ts 2>/dev/null || echo 'no tests'",
    "fmt": "prettier --check \"src/**/*.{ts,tsx,css}\" \"index.html\" \"vite.config.ts\""
  },
  "dependencies": {
    "@ribat/shared": "workspace:*",
    "i18next": "^25.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}

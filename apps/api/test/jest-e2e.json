{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@prisma/client/runtime/client$": "@prisma/client/runtime/client",
    "^@prisma/client$": "<rootDir>/../src/generated/prisma/client.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}

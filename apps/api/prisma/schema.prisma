generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  OWNER
  NONE
}

enum IdentityStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  SHEIKH
  ORG_ADMIN
  MEMBER
  GUARDIAN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  ARCHIVED
}

enum GuardianRelation {
  FATHER
  MOTHER
  OTHER
}

enum MemberNoteVisibility {
  SHEIKH_ONLY
  STAFF
}

enum ActiveView {
  ADMIN
  MEMBER
}

enum MaterialKind {
  QURAN
  TEXT
  BOOK
}

enum MaterialTrack {
  MEMORIZATION
  EXPLANATION
}

enum CourseType {
  MEMORIZATION
  EXPLANATION
  BOTH
}

enum CourseStatus {
  DRAFT
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum RequirementType {
  MIN_AGE
  MAX_AGE
  COMPLETED_COURSE
  MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum TeachingRole {
  LEAD
  TEACHER
}

enum TimeAnchor {
  FIXED
  PRAYER
}

enum Prayer {
  FAJR
  SUNRISE
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum SessionStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum WriteSource {
  ONLINE
  OFFLINE
}

enum MemorizationType {
  NEW
  REVISION
  INITIAL
  TEST
}

enum StudyStatus {
  SCHOOL
  UNIVERSITY
  NOT_STUDYING
}

enum EducationLevel {
  NONE
  PRIMARY
  MIDDLE
  SECONDARY
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

enum Grade {
  EXCELLENT
  VERY_GOOD
  GOOD
  REPEAT
}

enum TestScope {
  JUZ
  SURAH
  RANGE
  TEXT_PAGES
}

enum ExcuseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum HomeworkTarget {
  COURSE
  GROUP
  MEMBER
}

enum HomeworkTaskStatus {
  ASSIGNED
  DONE
  MISSED
}

enum NotificationType {
  ABSENCE_SUMMARY
  ATTENDANCE_OVERRIDDEN
  TEST_RESULT
  HOMEWORK_ASSIGNED
  HOMEWORK_MISSED
  SCHEDULE_CHANGE
  EXCUSE_DECIDED
  SESSION_NOT_TAKEN
}

enum DeliveryStatus {
  PENDING
  DONE
  FAILED
  DEAD
}

/// Rejected mutations are not stored, so a retry after the cause is fixed can apply.
enum SyncStatus {
  APPLIED
  SUPERSEDED
}

// ---------------------------------------------------------------------------
// Platform and tenancy (4)
// ---------------------------------------------------------------------------
model Organization {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  slug                String                @unique
  status              OrganizationStatus    @default(ACTIVE)
  timezone            String
  latitude            Decimal               @db.Decimal(9, 6)
  longitude           Decimal               @db.Decimal(9, 6)
  prayerMethod        String
  prayerOffsets       Json                  @default("{}")
  settings            Json                  @default("{}")
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)
  memberships         Membership[]
  members             Member[]
  households          Household[]
  guardianLinks       GuardianLink[]
  memberNotes         MemberNote[]
  auditLogs           AuditLog[]
  materials           Material[]
  courses             Course[]
  courseMaterials     CourseMaterial[]
  courseRequirements  CourseRequirement[]
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  courseGroups        CourseGroup[]
  groupMembers        GroupMember[]
  courseSchedules     CourseSchedule[]
  coursePauses        CoursePause[]
  courseSessions      CourseSession[]
  attendance          Attendance[]
  memorizationLogs    MemorizationLog[]
  memorizationTests   MemorizationTest[]
  memorizationSums    MemorizationSummary[]
  materialLogs        MaterialLog[]
  syncMutations       SyncMutation[]
  excuseRequests      ExcuseRequest[]
  homework            Homework[]
  homeworkTasks       HomeworkTask[]
  notifications       Notification[]
  domainEvents        DomainEvent[]

  @@index([status])
}

model Identity {
  id                String             @id @default(uuid()) @db.Uuid
  phone             String             @unique
  passwordHash      String?
  platformRole      PlatformRole       @default(NONE)
  status            IdentityStatus     @default(ACTIVE)
  lastLoginAt       DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  memberships       Membership[]
  authSessions      AuthSession[]
  accountSetupCodes AccountSetupCode[]
  auditLogs         AuditLog[]         @relation("AuditLogActorIdentity")

  @@index([status])
}

model Membership {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  identityId       String             @db.Uuid
  role             MembershipRole
  memberId         String?            @db.Uuid
  status           MembershipStatus   @default(ACTIVE)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  organization     Organization       @relation(fields: [organizationId], references: [id])
  identity         Identity           @relation(fields: [identityId], references: [id])
  member           Member?            @relation(fields: [memberId], references: [id])
  issuedSetupCodes AccountSetupCode[] @relation("SetupCodeIssuedBy")
  auditLogs        AuditLog[]         @relation("AuditLogActorMembership")

  @@unique([identityId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@index([memberId])
}

model AuthSession {
  id          String     @id @default(uuid()) @db.Uuid
  identityId  String     @db.Uuid
  tokenHash   String     @unique
  deviceLabel String?
  userAgent   String?
  activeView  ActiveView @default(ADMIN)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  lastSeenAt  DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime   @db.Timestamptz(6)
  revokedAt   DateTime?  @db.Timestamptz(6)
  identity    Identity   @relation(fields: [identityId], references: [id])

  @@index([identityId, revokedAt])
  @@index([expiresAt])
}

model AccountSetupCode {
  id                    String     @id @default(uuid()) @db.Uuid
  identityId            String     @db.Uuid
  codeHash              String
  expiresAt             DateTime   @db.Timestamptz(6)
  usedAt                DateTime?  @db.Timestamptz(6)
  createdByMembershipId String     @db.Uuid
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  identity              Identity   @relation(fields: [identityId], references: [id])
  createdByMembership   Membership @relation("SetupCodeIssuedBy", fields: [createdByMembershipId], references: [id])

  @@index([identityId, usedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// People (5)
// ---------------------------------------------------------------------------
model Household {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        Member[]

  @@index([organizationId])
}

model Member {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  householdId             String?               @db.Uuid
  firstName               String
  fatherName              String
  familyName              String
  motherName              String?
  birthDate               DateTime              @db.Date
  phone                   String?
  address                 String?
  schoolGrade             String?
  schoolName              String?
  studyStatus             StudyStatus?
  university              String?
  faculty                 String?
  universityYear          Int?
  highestEducation        EducationLevel?
  joinedAt                DateTime              @db.Date
  notes                   String?
  status                  MemberStatus          @default(ACTIVE)
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)
  archivedAt              DateTime?             @db.Timestamptz(6)
  organization            Organization          @relation(fields: [organizationId], references: [id])
  household               Household?            @relation(fields: [householdId], references: [id])
  memberships             Membership[]
  guardianLinksAsGuardian GuardianLink[]        @relation("GuardianMember")
  guardianLinksAsWard     GuardianLink[]        @relation("WardMember")
  memberNotesAbout        MemberNote[]          @relation("MemberNoteSubject")
  memberNotesAuthored     MemberNote[]          @relation("MemberNoteAuthor")
  enrollments             Enrollment[]
  teachingAssignments     TeachingAssignment[]
  taughtGroups            CourseGroup[]
  attendanceMarked        Attendance[]          @relation("AttendanceMarkedBy")
  memorizationLogs        MemorizationLog[]     @relation("MemorizationLogMember")
  memorizationLogsWritten MemorizationLog[]     @relation("MemorizationLogAuthor")
  memorizationTests       MemorizationTest[]    @relation("MemorizationTestMember")
  testsExamined           MemorizationTest[]    @relation("MemorizationTestExaminer")
  memorizationSummaries   MemorizationSummary[]
  materialLogsWritten     MaterialLog[]

  @@index([organizationId, status])
  @@index([organizationId, familyName, firstName])
  @@index([householdId])
}

model GuardianLink {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  guardianMemberId String           @db.Uuid
  wardMemberId     String           @db.Uuid
  relation         GuardianRelation
  isPrimary        Boolean          @default(false)
  organization     Organization     @relation(fields: [organizationId], references: [id])
  guardianMember   Member           @relation("GuardianMember", fields: [guardianMemberId], references: [id])
  wardMember       Member           @relation("WardMember", fields: [wardMemberId], references: [id])

  @@unique([guardianMemberId, wardMemberId])
  @@index([organizationId])
  @@index([wardMemberId])
  @@index([guardianMemberId])
}

model MemberNote {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  memberId       String               @db.Uuid
  courseId       String?              @db.Uuid
  authorMemberId String               @db.Uuid
  body           String
  visibility     MemberNoteVisibility @default(SHEIKH_ONLY)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id])
  member         Member               @relation("MemberNoteSubject", fields: [memberId], references: [id])
  authorMember   Member               @relation("MemberNoteAuthor", fields: [authorMemberId], references: [id])
  course         Course?              @relation(fields: [courseId], references: [id])

  @@index([organizationId, memberId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Courses and teaching (§6)
// ---------------------------------------------------------------------------
/// One QURAN row per organization (partial unique index in the S2 migration).
model Material {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @db.Uuid
  kind              MaterialKind
  title             String
  author            String?
  totalPages        Int?
  url               String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  archivedAt        DateTime?             @db.Timestamptz(6)
  organization      Organization          @relation(fields: [organizationId], references: [id])
  courseMaterials   CourseMaterial[]
  groups            CourseGroup[]
  memorizationLogs  MemorizationLog[]
  memorizationTests MemorizationTest[]
  summaries         MemorizationSummary[]
  materialLogs      MaterialLog[]

  @@index([organizationId, archivedAt])
}

model Course {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  name              String
  description       String?
  type              CourseType
  status            CourseStatus         @default(DRAFT)
  startDate         DateTime?            @db.Date
  endDate           DateTime?            @db.Date
  location          String?
  minAge            Int?
  maxAge            Int?
  capacity          Int?
  isHierarchical    Boolean              @default(false)
  hasGroups         Boolean              @default(false)
  testPassMark      Int                  @default(60)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  organization      Organization         @relation(fields: [organizationId], references: [id])
  materials         CourseMaterial[]
  requirements      CourseRequirement[]
  enrollments       Enrollment[]
  teachers          TeachingAssignment[]
  groups            CourseGroup[]
  schedules         CourseSchedule[]
  pauses            CoursePause[]
  sessions          CourseSession[]
  memberNotes       MemberNote[]
  memorizationLogs  MemorizationLog[]
  memorizationTests MemorizationTest[]

  @@index([organizationId, status])
}

model CourseMaterial {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  courseId       String        @db.Uuid
  materialId     String        @db.Uuid
  track          MaterialTrack
  order          Int           @default(0)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  course         Course        @relation(fields: [courseId], references: [id])
  material       Material      @relation(fields: [materialId], references: [id])

  @@unique([courseId, materialId])
  @@index([organizationId])
}

model CourseRequirement {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  courseId       String          @db.Uuid
  type           RequirementType
  value          Json            @default("{}")
  description    String?
  organization   Organization    @relation(fields: [organizationId], references: [id])
  course         Course          @relation(fields: [courseId], references: [id])

  @@index([organizationId, courseId])
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  courseId       String           @db.Uuid
  memberId       String           @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  startedAt      DateTime         @db.Date
  endedAt        DateTime?        @db.Date
  organization   Organization     @relation(fields: [organizationId], references: [id])
  course         Course           @relation(fields: [courseId], references: [id])
  member         Member           @relation(fields: [memberId], references: [id])
  groupMembers   GroupMember[]
  attendance     Attendance[]

  @@unique([courseId, memberId])
  @@index([organizationId, memberId])
}

model TeachingAssignment {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  courseId        String       @db.Uuid
  teacherMemberId String       @db.Uuid
  role            TeachingRole
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  endedAt         DateTime?    @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id])
  course          Course       @relation(fields: [courseId], references: [id])
  teacher         Member       @relation(fields: [teacherMemberId], references: [id])

  @@unique([courseId, teacherMemberId])
  @@index([organizationId, teacherMemberId])
}

/// DM-06: materialKey is materialId::text or 'ALL' (CHECK in the S2 migration).
/// GroupMember references (id, materialKey), so a student's group rows carry the
/// group's material and (enrollmentId, materialKey) is unique: one teacher per material.
model CourseGroup {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  courseId        String        @db.Uuid
  name            String
  teacherMemberId String        @db.Uuid
  materialId      String?       @db.Uuid
  materialKey     String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  course          Course        @relation(fields: [courseId], references: [id])
  teacher         Member        @relation(fields: [teacherMemberId], references: [id])
  material        Material?     @relation(fields: [materialId], references: [id])
  members         GroupMember[]
  materialLogs    MaterialLog[]

  @@unique([id, materialKey])
  @@index([organizationId, courseId])
}

model GroupMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  groupId        String       @db.Uuid
  materialKey    String
  enrollmentId   String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  group          CourseGroup  @relation(fields: [groupId, materialKey], references: [id, materialKey], onDelete: Cascade)
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, materialKey])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Scheduling (§7)
// ---------------------------------------------------------------------------
model CourseSchedule {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  courseId       String          @db.Uuid
  weekday        Int
  startAnchor    TimeAnchor
  startTime      String?
  startPrayer    Prayer?
  startOffsetMin Int             @default(0)
  endAnchor      TimeAnchor
  endTime        String?
  endPrayer      Prayer?
  endOffsetMin   Int             @default(0)
  effectiveFrom  DateTime        @db.Date
  effectiveTo    DateTime?       @db.Date
  organization   Organization    @relation(fields: [organizationId], references: [id])
  course         Course          @relation(fields: [courseId], references: [id])
  sessions       CourseSession[]

  @@index([organizationId, courseId])
}

model CoursePause {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  courseId       String       @db.Uuid
  fromDate       DateTime     @db.Date
  toDate         DateTime     @db.Date
  reason         String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  course         Course       @relation(fields: [courseId], references: [id])

  @@index([organizationId, courseId])
}

model CourseSession {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  courseId       String          @db.Uuid
  date           DateTime        @db.Date
  startsAt       DateTime        @db.Timestamptz(6)
  endsAt         DateTime        @db.Timestamptz(6)
  status         SessionStatus   @default(SCHEDULED)
  topic          String?
  scheduleId     String?         @db.Uuid
  isException    Boolean         @default(false)
  organization   Organization    @relation(fields: [organizationId], references: [id])
  course         Course          @relation(fields: [courseId], references: [id])
  schedule       CourseSchedule? @relation(fields: [scheduleId], references: [id])
  attendance     Attendance[]
  materialLogs   MaterialLog[]

  @@unique([courseId, date, startsAt])
  @@index([organizationId, date])
  @@index([courseId, date])
}

// ---------------------------------------------------------------------------
// Attendance and progress (§7–8, S3)
// ---------------------------------------------------------------------------
/// DM-09: one row per (session, enrollment); the latest markedAt wins.
/// idempotencyKey is the key of the write that produced the current value.
model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  sessionId        String           @db.Uuid
  enrollmentId     String           @db.Uuid
  status           AttendanceStatus
  markedByMemberId String           @db.Uuid
  markedAt         DateTime         @db.Timestamptz(6)
  source           WriteSource
  idempotencyKey   String           @db.Uuid
  supersededCount  Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id])
  session          CourseSession    @relation(fields: [sessionId], references: [id])
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id])
  markedBy         Member           @relation("AttendanceMarkedBy", fields: [markedByMemberId], references: [id])

  @@unique([sessionId, enrollmentId])
  @@unique([organizationId, idempotencyKey])
  @@index([enrollmentId, markedAt(sort: Desc)])
}

/// DM-08: append-only. A mistake is voided with a reason, never edited.
model MemorizationLog {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  memberId         String           @db.Uuid
  materialId       String           @db.Uuid
  courseId         String?          @db.Uuid
  type             MemorizationType
  surahStart       Int?
  ayahStart        Int?
  surahEnd         Int?
  ayahEnd          Int?
  pageFrom         Int
  pageTo           Int
  ayahCount        Int?
  grade            Grade?
  mistakes         Int              @default(0)
  note             String?
  loggedByMemberId String           @db.Uuid
  loggedAt         DateTime         @db.Timestamptz(6)
  source           WriteSource
  idempotencyKey   String           @db.Uuid
  voidedAt         DateTime?        @db.Timestamptz(6)
  voidedByMemberId String?          @db.Uuid
  voidReason       String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id])
  member           Member           @relation("MemorizationLogMember", fields: [memberId], references: [id])
  material         Material         @relation(fields: [materialId], references: [id])
  course           Course?          @relation(fields: [courseId], references: [id])
  loggedBy         Member           @relation("MemorizationLogAuthor", fields: [loggedByMemberId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, memberId, loggedAt(sort: Desc)])
  @@index([courseId, loggedAt(sort: Desc)])
  @@index([materialId, memberId])
}

/// Every attempt is kept (WF-07).
model MemorizationTest {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  memberId         String       @db.Uuid
  materialId       String       @db.Uuid
  courseId         String?      @db.Uuid
  scopeType        TestScope
  juz              Int?
  surahStart       Int?
  ayahStart        Int?
  surahEnd         Int?
  ayahEnd          Int?
  pageFrom         Int?
  pageTo           Int?
  score            Int
  passMark         Int
  passed           Boolean
  attemptNo        Int
  examinerMemberId String       @db.Uuid
  takenAt          DateTime     @db.Timestamptz(6)
  notes            String?
  idempotencyKey   String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id])
  member           Member       @relation("MemorizationTestMember", fields: [memberId], references: [id])
  material         Material     @relation(fields: [materialId], references: [id])
  course           Course?      @relation(fields: [courseId], references: [id])
  examiner         Member       @relation("MemorizationTestExaminer", fields: [examinerMemberId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, memberId, takenAt(sort: Desc)])
}

/// ADR-0010: derived, rewritten in the same transaction as every log and void.
/// Disposable — `pnpm --filter api projections:rebuild` recreates it from the ledger.
model MemorizationSummary {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  memberId        String       @db.Uuid
  materialId      String       @db.Uuid
  pagesMemorized  Int
  ayahsMemorized  Int
  lastPageReached Int?
  lastSurah       Int?
  lastAyah        Int?
  lastLoggedAt    DateTime?    @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id])
  member          Member       @relation(fields: [memberId], references: [id])
  material        Material     @relation(fields: [materialId], references: [id])

  @@unique([memberId, materialId])
  @@index([organizationId])
}

/// Explanation pages, once per class or group (decision 7.1). Append-only.
model MaterialLog {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  sessionId        String        @db.Uuid
  materialId       String        @db.Uuid
  groupId          String?       @db.Uuid
  pageFrom         Int
  pageTo           Int
  note             String?
  loggedByMemberId String        @db.Uuid
  loggedAt         DateTime      @db.Timestamptz(6)
  source           WriteSource
  idempotencyKey   String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  organization     Organization  @relation(fields: [organizationId], references: [id])
  session          CourseSession @relation(fields: [sessionId], references: [id])
  material         Material      @relation(fields: [materialId], references: [id])
  group            CourseGroup?  @relation(fields: [groupId], references: [id])
  loggedBy         Member        @relation(fields: [loggedByMemberId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([sessionId])
}

/// SYNC-10: one row per applied offline mutation; a repeated key returns `result`.
model SyncMutation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  membershipId   String       @db.Uuid
  idempotencyKey String       @db.Uuid
  type           String
  status         SyncStatus
  result         Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, idempotencyKey])
}

// ---------------------------------------------------------------------------
// Families and communication (§7, §9, §10, §12 — S4)
// ---------------------------------------------------------------------------
/// Decision 8.3: accepting sets matching attendance to EXCUSED.
model ExcuseRequest {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  memberId              String       @db.Uuid
  courseId              String?      @db.Uuid
  fromDate              DateTime     @db.Date
  toDate                DateTime     @db.Date
  reason                String
  submittedByIdentityId String       @db.Uuid
  status                ExcuseStatus @default(PENDING)
  decidedByMembershipId String?      @db.Uuid
  decidedAt             DateTime?    @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  organization          Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, memberId, fromDate])
}

/// Decision 10.2: target a course, a group or one member; tasks are expanded at creation.
model Homework {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  courseId          String         @db.Uuid
  targetType        HomeworkTarget
  groupId           String?        @db.Uuid
  memberId          String?        @db.Uuid
  title             String
  description       String?
  dueDate           DateTime       @db.Date
  createdByMemberId String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  organization      Organization   @relation(fields: [organizationId], references: [id])
  tasks             HomeworkTask[]

  @@index([organizationId, courseId, dueDate])
}

model HomeworkTask {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  homeworkId       String             @db.Uuid
  enrollmentId     String             @db.Uuid
  status           HomeworkTaskStatus @default(ASSIGNED)
  markedByMemberId String?            @db.Uuid
  markedAt         DateTime?          @db.Timestamptz(6)
  organization     Organization       @relation(fields: [organizationId], references: [id])
  homework         Homework           @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, enrollmentId])
  @@index([enrollmentId, status])
}

/// Keys and params, not sentences: each reader sees their own language (NFR-01).
/// dedupeKey makes every producer idempotent: redelivery or a rerun job inserts nothing.
model Notification {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  recipientIdentityId String           @db.Uuid
  type                NotificationType
  titleKey            String
  bodyKey             String
  params              Json             @default("{}")
  entityType          String?
  entityId            String?          @db.Uuid
  dedupeKey           String
  readAt              DateTime?        @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  organization        Organization     @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, dedupeKey])
  @@index([recipientIdentityId, readAt, createdAt(sort: Desc)])
}

/// ADR-0009: written in the same transaction as the change it describes. IDs and facts only.
model DomainEvent {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  type              String
  aggregateType     String
  aggregateId       String          @db.Uuid
  payload           Json
  requestId         String?
  actorMembershipId String?         @db.Uuid
  occurredAt        DateTime        @default(now()) @db.Timestamptz(6)
  dispatchedAt      DateTime?       @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id])
  deliveries        EventDelivery[]

  @@index([dispatchedAt, occurredAt])
  @@index([organizationId, type, occurredAt(sort: Desc)])
}

/// Unique (eventId, handler): the constraint that makes redelivery a no-op (EV-03).
/// Not tenant-scoped on its own; always reached through its event.
model EventDelivery {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @db.Uuid
  handler       String
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime?      @db.Timestamptz(6)
  completedAt   DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  event         DomainEvent    @relation(fields: [eventId], references: [id])

  @@unique([eventId, handler])
  @@index([status])
}

// ---------------------------------------------------------------------------
// System (§12 — audit only for S1)
// ---------------------------------------------------------------------------
model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  actorIdentityId   String?      @db.Uuid
  actorMembershipId String?      @db.Uuid
  action            String
  entityType        String
  entityId          String       @db.Uuid
  before            Json?
  after             Json?
  requestId         String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id])
  actorIdentity     Identity?    @relation("AuditLogActorIdentity", fields: [actorIdentityId], references: [id])
  actorMembership   Membership?  @relation("AuditLogActorMembership", fields: [actorMembershipId], references: [id])

  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../docs/internal/erd.svg"
  theme    = "neutral"
}
